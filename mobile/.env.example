# Optional in development: defaults to the Expo computer's host on port 3000.
# On a phone, use your computer's LAN address or a reachable tunnel URL.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000/v1

# Leave empty for the explicitly labelled local demo accounts.
# Add your Clerk publishable key after setting up the same Clerk app on backend.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# EXPO_PUBLIC_ values are visible to app users. Never put server secrets here.
