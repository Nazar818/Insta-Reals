# Standard deployment: a PostgreSQL URL and Clerk verification credentials.
# npm run demo supplies its own local DATABASE_URL and enables demo mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reals
PORT=3000
DEMO_MODE=false
# Use your Mac's LAN IP for device testing, e.g. http://192.168.1.10:3000
API_PUBLIC_URL=http://localhost:3000
DATA_DIR=.data
DEMO_DATABASE_PORT=5433
CLERK_SECRET_KEY=
# A PEM public verification key can be used instead of CLERK_SECRET_KEY.
CLERK_JWT_KEY=
# Optional comma-separated expected session origins for deployed Clerk apps.
CLERK_AUTHORIZED_PARTIES=
PEXELS_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Copy this file to .env and replace the placeholder with your Clerk secret key.
CLERK_SECRET_KEY=sk_test_replace_me

# Optional comma-separated allowed client origins. Configure this when the
# mobile development and production origins are agreed.
CLERK_AUTHORIZED_PARTIES=
